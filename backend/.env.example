# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Application Settings
DEBUG=false
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security / Auth
JWT_SECRET=your-secure-random-jwt-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PROVISIONING_SECRET=your-secure-provisioning-secret-key

# CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Rate Limiting & DoS Protection
LOGIN_RATE_LIMIT_CALLS=5
LOGIN_RATE_LIMIT_PERIOD_SECONDS=60
RATE_LIMIT_MAX_KEYS=10000
MAX_REQUEST_SIZE_BYTES=2097152

# Database Connection Pool
DATABASE_TIMEOUT=5.0
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Ride Operations
RIDE_TIMEOUT_SECONDS=300
TIMEOUT_SWEEP_INTERVAL_SECONDS=60

# Payments (Daraja STK Push)
DARAJA_ENVIRONMENT=sandbox
DARAJA_CONSUMER_KEY=your-daraja-consumer-key
DARAJA_CONSUMER_SECRET=your-daraja-consumer-secret
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=your-daraja-passkey
DARAJA_CALLBACK_BASE_URL=https://api.yourdomain.com
DARAJA_TIMEOUT_SECONDS=10
