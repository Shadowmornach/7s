# Database Configuration (Direct PostgreSQL or Transaction Pooler DSN)
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST:6543/YOUR_DB_NAME

# Application Settings
DEBUG=false
ENVIRONMENT=production
LOG_LEVEL=INFO

# Security / Auth
JWT_SECRET=YOUR_SECURE_RANDOM_JWT_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PROVISIONING_SECRET=YOUR_SECURE_PROVISIONING_SECRET_KEY
PROVISIONING_ALLOWED_IPS=127.0.0.1,::1

# CORS Origins (comma separated)
CORS_ORIGINS=https://app.7s.co.ke,https://api.7s.co.ke

# Rate Limiting & DoS Protection
LOGIN_RATE_LIMIT_CALLS=5
LOGIN_RATE_LIMIT_PERIOD_SECONDS=60
RATE_LIMIT_MAX_KEYS=10000
MAX_REQUEST_SIZE_BYTES=2097152

# Database Connection Pool
DATABASE_TIMEOUT=5.0
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Ride Operations
RIDE_TIMEOUT_SECONDS=300
TIMEOUT_SWEEP_INTERVAL_SECONDS=60

# External Services (Optional / Future Use)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
ORS_API_KEY=YOUR_OPENROUTESERVICE_API_KEY

# Payments (BambaStack M-Pesa Gateway)
BAMBASTACK_API_KEY=YOUR_BAMBASTACK_API_KEY
BAMBASTACK_BASE_URL=https://majengo-backend-593721555291.us-central1.run.app
BAMBASTACK_TIMEOUT_SECONDS=15
