# 7s Mobile Environment Parameters (Pass via Flutter --dart-define or build configuration)

# Environment Mode: development | staging | production
ENV=development

# API Base URL Guidance:
# - Android Emulator (Local): http://10.0.2.2:8000
# - Physical Mobile Device (Local WiFi): http://192.168.X.X:8000
